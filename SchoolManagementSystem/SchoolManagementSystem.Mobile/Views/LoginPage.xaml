<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SchoolManagementSystem.Mobile.Views.LoginPage"
    Title="Login"
    BackgroundColor="#f3f7fb">

    <ContentPage.Resources>

        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#163550" />
        </Style>

        <Style x:Key="LoginEntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="#2c3e50" />
            <Setter Property="PlaceholderColor" Value="#526579" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <Grid
            Padding="24,32"
            RowDefinitions="*">

            <VerticalStackLayout
                Spacing="24"
                MaximumWidthRequest="460"
                HorizontalOptions="Fill"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <Border
                        Padding="16"
                        WidthRequest="140"
                        HeightRequest="140"
                        HorizontalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#e2e8f0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24">

                        <Image
                            Source="mobile_logo.png"
                            Aspect="AspectFit"
                            SemanticProperties.Description="School Management System logo" />

                    </Border>

                    <Label
                        Text="School Management System"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#09233f"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Connecting you to your school."
                        FontSize="14"
                        TextColor="#526579"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <Border
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="#e2e8f0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="0">

                        <Border
                            Padding="24"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16,16,0,0">

                            <Border.Background>
                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="1,1">

                                    <GradientStop
                                        Color="#09233f"
                                        Offset="0" />

                                    <GradientStop
                                        Color="#0b5fa5"
                                        Offset="1" />

                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="STUDENT PORTAL"
                                    FontSize="11"
                                    CharacterSpacing="1.5"
                                    FontAttributes="Bold"
                                    TextColor="#dce6ef" />

                                <Label
                                    Text="Welcome back"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="Sign in to view your learning information."
                                    FontSize="14"
                                    TextColor="#eaf0f6" />

                            </VerticalStackLayout>
                        </Border>

                        <!-- Form -->
                        <VerticalStackLayout
                            Padding="24"
                            Spacing="20">

                            <VerticalStackLayout Spacing="7">

                                <Label
                                    Text="Email"
                                    Style="{StaticResource FieldLabelStyle}" />

                                <Border
                                    Padding="10,0"
                                    BackgroundColor="White"
                                    Stroke="#dce3eb"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8">

                                    <Entry
                                        x:Name="EmailEntry"
                                        Style="{StaticResource LoginEntryStyle}"
                                        Placeholder="Enter your email"
                                        Keyboard="Email"
                                        IsTextPredictionEnabled="False"
                                        ReturnType="Next"
                                        Completed="OnEmailCompleted" />

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="7">

                                <Label
                                    Text="Password"
                                    Style="{StaticResource FieldLabelStyle}" />

                                <Border
                                    Padding="10,0"
                                    BackgroundColor="White"
                                    Stroke="#dce3eb"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8">

                                    <Entry
                                        x:Name="PasswordEntry"
                                        Style="{StaticResource LoginEntryStyle}"
                                        Placeholder="Enter your password"
                                        IsPassword="True"
                                        IsTextPredictionEnabled="False"
                                        ReturnType="Go"
                                        Completed="OnLoginClicked" />

                                </Border>
                            </VerticalStackLayout>

                            <Label
                                x:Name="ErrorLabel"
                                FontSize="13"
                                TextColor="#b42318"
                                IsVisible="False"
                                SemanticProperties.Description="Login error" />

                            <ActivityIndicator
                                x:Name="LoadingIndicator"
                                Color="#155b91"
                                IsRunning="False"
                                IsVisible="False" />

                            <Button
                                x:Name="LoginButton"
                                Text="Sign in"
                                BackgroundColor="#2c3e50"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="48"
                                FontSize="15"
                                FontAttributes="Bold"
                                Clicked="OnLoginClicked" />

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="Your learning, in one place."
                    FontSize="12"
                    TextColor="#526579"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>