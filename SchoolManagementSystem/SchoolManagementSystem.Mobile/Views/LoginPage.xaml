<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SchoolManagementSystem.Mobile.Views.LoginPage"
    Title="Login">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18"
            MaximumWidthRequest="440"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <Label
                Text="School Management"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Sign in to view your learning history."
                HorizontalTextAlignment="Center" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Email" />

                <Entry
                    x:Name="EmailEntry"
                    Placeholder="Enter your email"
                    Keyboard="Email"
                    ReturnType="Next"
                    Completed="OnEmailCompleted" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Password" />

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Enter your password"
                    IsPassword="True"
                    ReturnType="Go"
                    Completed="OnLoginClicked" />
            </VerticalStackLayout>

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False"
                SemanticProperties.Description="Login error" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <Button
                x:Name="LoginButton"
                Text="Sign in"
                Clicked="OnLoginClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>