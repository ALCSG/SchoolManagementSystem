@model IEnumerable<SchoolManagementSystem.Data.Entities.ClassGroup>

@{
    ViewData["Title"] = "Class Groups";

    var classGroups = Model.Select(group => new
    {
        ClassGroupId = group.ClassGroupId,
        Description = group.Description,
        CourseName = group.Course?.Name ?? "Not available",
        ActiveStudentCount = group.Students.Count(s => !s.IsArchived),
        DetailsUrl = Url.Action("Details", "ClassGroup",
            new { id = group.ClassGroupId }),
        EditUrl = Url.Action("Edit", "ClassGroup",
            new { id = group.ClassGroupId }),
        DeleteUrl = Url.Action("Delete", "ClassGroup",
            new { id = group.ClassGroupId }),
        GradesUrl = Url.Action("Grades", "ClassGroup",
            new { id = group.ClassGroupId})
    }).ToList();
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">
    <h1 class="h3 mb-0">Class Groups</h1>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            New Class Group
        </a>
    }
</div>

<script id="classGroupActionsTemplate" type="text/x-template">
    <div class="d-flex flex-wrap gap-1">
        <a href="${DetailsUrl}"
           class="btn btn-sm btn-outline-secondary">
            Details
        </a>

        <a href="${GradesUrl}"
            class="btn btn-sm btn-outline-success">
            Grades & Absences
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a href="${EditUrl}"
               class="btn btn-sm btn-outline-primary">
                Edit
            </a>

            <a href="${DeleteUrl}"
               class="btn btn-sm btn-outline-danger">
                Delete
            </a>
        }
    </div>
</script>

<ejs-grid id="ClassGroupsGrid"
          dataSource="@classGroups"
          allowPaging="true"
          allowSorting="true"
          allowFiltering="true"
          toolbar="@(new List<string> { "Search" })"
          width="100%">

    <e-grid-pagesettings pageSize="10"
                         pageCount="5">
    </e-grid-pagesettings>

    <e-grid-filtersettings type="Menu">
    </e-grid-filtersettings>

    <e-grid-searchsettings fields="@(new string[]
                           {
                               "Description",
                               "CourseName"
                           })"
                           operator="contains"
                           ignoreCase="true">
    </e-grid-searchsettings>

    <e-grid-columns>
        <e-grid-column field="ClassGroupId"
                       isPrimaryKey="true"
                       visible="false">
        </e-grid-column>

        <e-grid-column field="Description"
                       headerText="Description"
                       width="230">
        </e-grid-column>

        <e-grid-column field="CourseName"
                       headerText="Course"
                       width="230">
        </e-grid-column>

        <e-grid-column field="ActiveStudentCount"
                       headerText="Active Students"
                       type="number"
                       textAlign="Center"
                       width="160">
        </e-grid-column>

        <e-grid-column headerText="Actions"
                       template="#classGroupActionsTemplate"
                       allowSorting="false"
                       allowFiltering="false"
                       width="260">
        </e-grid-column>
    </e-grid-columns>
</ejs-grid>