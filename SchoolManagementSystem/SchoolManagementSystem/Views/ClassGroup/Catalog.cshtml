@model IEnumerable<SchoolManagementSystem.Data.Entities.ClassGroup>

@{
    ViewData["Title"] = "Class Groups";
}

<div class="mb-4">
    <h1 class="h3 mb-2">Class Groups</h1>

    <p class="text-muted mb-0">
        Explore the available class groups and select a course to view its subjects.
    </p>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <p class="text-muted mb-0">
                There are no class groups available at the moment.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var group in Model.OrderBy(g => g.Course.Name)
                                   .ThenBy(g => g.Description))
        {
            <div class="col-md-6 col-lg-4">
                <section class="card h-100 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">
                            @group.Description
                        </h2>

                        <p class="text-muted small mb-1">
                            Course
                        </p>

                        <a asp-controller="Course"
                           asp-action="PublicDetails"
                           asp-route-id="@group.CourseId"
                           class="text-decoration-none">
                            @group.Course.Name
                        </a>
                    </div>
                </section>
            </div>
        }
    </div>
}