@model SchoolManagementSystem.Data.Entities.Course

@{
    ViewData["Title"] = "Course Details";
}

<h1>Course Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

<h4 class="mt-4">Subjects</h4>
@if (Model.Subjects.Any())
{
    <ul>
        @foreach (var subject in Model.Subjects.OrderBy(s => s.Name))
        {
            <li>@subject.Name</li>
        }
    </ul>
}
else
{
    <p class="text-muted">No subjects linked to this course yet.</p>
}

<h4 class="mt-4">Class Groups</h4>
@if (Model.Groups.Any())
{
    <ul>
        @foreach (var group in Model.Groups)
        {
            <li>@group.Description</li>
        }
    </ul>
}
else
{
    <p class="text-muted">No class groups yet.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>