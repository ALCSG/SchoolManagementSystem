@model SchoolManagementSystem.Data.Entities.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>
<h3 class="text-danger">Are you sure you want to delete this course?</h3>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Class Groups</dt>
    <dd class="col-sm-9">@Model.Groups.Count</dd>

    <dt class="col-sm-3">Subjects</dt>
    <dd class="col-sm-9">@Model.Subjects.Count</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.CourseId">
    <input type="hidden" asp-for="CourseId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<hr />

<div asp-validation-summary="All" class="text-danger"></div>