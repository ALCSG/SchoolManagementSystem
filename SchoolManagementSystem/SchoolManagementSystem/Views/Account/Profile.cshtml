@model SchoolManagementSystem.Models.ProfileViewModel

@{
    ViewData["Title"] = "My profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="mb-4">
                <h1 class="h3 mb-1">My profile</h1>
                <p class="text-muted mb-0">
                    Manage your personal information and profile picture.
                </p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="Account"
                          asp-action="Profile"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-4">

                            <div class="col-12 col-md-4">
                                <div class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePicturePath))
                                    {
                                        <img src="@Url.Content(Model.ProfilePicturePath)"
                                             alt="Current profile picture"
                                             class="rounded-circle border mb-3"
                                             style="width: 150px; height: 150px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle border bg-light
                                            d-flex align-items-center
                                            justify-content-center mx-auto mb-3"
                                             style="width: 150px; height: 150px;">
                                            <span class="text-muted">No photo</span>
                                        </div>
                                    }

                                    <p class="small text-muted mb-0">
                                        Your current profile picture
                                    </p>
                                </div>
                            </div>

                            <div class="col-12 col-md-8">

                                <div class="row g-3">
                                    <div class="col-12 col-sm-6">
                                        <label asp-for="FirstName"
                                               class="form-label"></label>

                                        <input asp-for="FirstName"
                                               class="form-control"
                                               autocomplete="given-name" />

                                        <span asp-validation-for="FirstName"
                                              class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 col-sm-6">
                                        <label asp-for="LastName"
                                               class="form-label"></label>

                                        <input asp-for="LastName"
                                               class="form-control"
                                               autocomplete="family-name" />

                                        <span asp-validation-for="LastName"
                                              class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Email"
                                               class="form-label"></label>

                                        <input id="Email"
                                               type="email"
                                               value="@Model.Email"
                                               class="form-control"
                                               readonly
                                               aria-describedby="emailHelp" />

                                        <div id="emailHelp" class="form-text">
                                            Your email cannot be changed on this page.
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="PhoneNumber"
                                               class="form-label"></label>

                                        <input asp-for="PhoneNumber"
                                               type="tel"
                                               class="form-control"
                                               autocomplete="tel" />

                                        <span asp-validation-for="PhoneNumber"
                                              class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="ProfilePictureFile"
                                               class="form-label"></label>

                                        <input asp-for="ProfilePictureFile"
                                               type="file"
                                               accept=".jpg,.jpeg,.png"
                                               class="form-control"
                                               aria-describedby="pictureHelp" />

                                        <span asp-validation-for="ProfilePictureFile"
                                              class="text-danger small"></span>

                                        <div id="pictureHelp" class="form-text">
                                            Select a JPG or PNG image, up to 2 MB.
                                            Leave empty to keep your current picture.
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                Save changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}