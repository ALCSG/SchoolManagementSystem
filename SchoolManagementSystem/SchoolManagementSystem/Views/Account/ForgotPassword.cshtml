@model SchoolManagementSystem.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="mb-3">Forgot password</h1>
        <p class="text-muted">Enter your e-mail and we will send you a link to choose a new password.</p>

        <form asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <input type="submit" value="Send link" class="btn btn-primary" />
            <a asp-action="Login" class="btn btn-secondary">Back to login</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}