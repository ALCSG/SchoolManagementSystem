@using System.Net
@model IEnumerable<SchoolManagementSystem.Data.Entities.Course>

@{
    ViewData["Title"] = "Welcome";
    ViewData["ShowHero"] = true;

    var slides = Model
        .Take(5)
        .Select((course, index) => new SchoolManagementSystem.Models.CourseSlideViewModel
        {
            Id = index + 1,
            Name = WebUtility.HtmlEncode(course.Name),
            Subjects = course.Subjects.Any()
                ? WebUtility.HtmlEncode(string.Join(" · ", course.Subjects.OrderBy(s => s.Name).Select(s => s.Name)))
                : "No subjects yet",
            Summary = $"{course.Groups.Count} class group(s)"
        })
        .ToList();
}

@if (slides.Any())
{
    <ejs-carousel id="coursesCarousel"
                  cssClass="courses-carousel"
                  dataSource="@slides"
                  itemTemplate='<div class="course-slide"><h3>${Name}</h3><p>${Subjects}</p><span class="badge bg-light text-dark">${Summary}</span></div>'
                  interval="6000"
                  animationEffect="Fade"
                  buttonsVisibility="VisibleOnHover"
                  height="260px">
    </ejs-carousel>

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Courses" class="btn btn-outline-primary btn-lg">View all courses</a>
    </div>
}
else
{
    <p class="text-center text-muted">There are no courses available yet.</p>
}