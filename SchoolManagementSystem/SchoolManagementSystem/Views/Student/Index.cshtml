@using SchoolManagementSystem.Data.Entities
@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";

    var students = Model.Select(student => new
    {
        StudentId = student.StudentId,
        FullName = $"{student.FirstName} {student.LastName}",
        ClassGroupName = student.ClassGroup?.Description ?? "Not assigned",
        CourseName = student.ClassGroup?.Course?.Name ?? "Not available",
        DetailsUrl = Url.Action("Details", "Student",
            new { id = student.StudentId }),
        EditUrl = Url.Action("Edit", "Student",
            new { id = student.StudentId }),
        DeleteUrl = Url.Action("Delete", "Student",
            new { id = student.StudentId })
    }).ToList();
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">
    <h1 class="h3 mb-0">Students</h1>

    <a asp-action="Create" class="btn btn-primary">
        New Student
    </a>
</div>

<script id="studentActionsTemplate" type="text/x-template">
    <div class="d-flex flex-wrap gap-1">
        <a href="${DetailsUrl}"
           class="btn btn-sm btn-outline-secondary">
            Details
        </a>

        <a href="${EditUrl}"
           class="btn btn-sm btn-outline-primary">
            Edit
        </a>

        <a href="${DeleteUrl}"
           class="btn btn-sm btn-outline-danger">
            Delete
        </a>
    </div>
</script>

<ejs-grid id="StudentsGrid"
          dataSource="@students"
          allowPaging="true"
          allowSorting="true"
          allowFiltering="true"
          toolbar="@(new List<string> { "Search" })"
          width="100%">

    <e-grid-pagesettings pageSize="10"
                         pageCount="5">
    </e-grid-pagesettings>

    <e-grid-filtersettings type="Menu">
    </e-grid-filtersettings>

    <e-grid-searchsettings fields="@(new string[]
                           {
                               "FullName",
                               "ClassGroupName",
                               "CourseName"
                           })"
                           operator="contains"
                           ignoreCase="true">
    </e-grid-searchsettings>

    <e-grid-columns>
        <e-grid-column field="StudentId"
                       isPrimaryKey="true"
                       visible="false">
        </e-grid-column>

        <e-grid-column field="FullName"
                       headerText="Name"
                       width="230">
        </e-grid-column>

        <e-grid-column field="ClassGroupName"
                       headerText="Class"
                       width="180">
        </e-grid-column>

        <e-grid-column field="CourseName"
                       headerText="Course"
                       width="230">
        </e-grid-column>

        <e-grid-column headerText="Actions"
                       template="#studentActionsTemplate"
                       allowSorting="false"
                       allowFiltering="false"
                       width="260">
        </e-grid-column>
    </e-grid-columns>
</ejs-grid>