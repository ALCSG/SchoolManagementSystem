@model SchoolManagementSystem.Models.MyLearningViewModel

@{
    ViewData["Title"] = "My Learning";

    var student = Model.Student;
    var maxAbsencePercentage = Model.MaxAbsencePercentage;

    var enrollments = student.Enrollments
        .OrderBy(e => e.Subject.Name)
        .ToList();
}

<div class="mb-4">
    <h1 class="h3 mb-2">My Learning</h1>

    <p class="text-muted mb-0">
        View your subjects, grades, recorded absences and academic status.
    </p>
</div>

<section class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h2 class="h5 mb-3">
            @student.FirstName @student.LastName
        </h2>

        <dl class="row mb-0">
            <dt class="col-sm-3">Course</dt>
            <dd class="col-sm-9">
                @(student.ClassGroup?.Course?.Name ?? "Not available")
            </dd>

            <dt class="col-sm-3">Class group</dt>
            <dd class="col-sm-9">
                @(student.ClassGroup?.Description ?? "Not assigned")
            </dd>

            <dt class="col-sm-3">Absence limit</dt>
            <dd class="col-sm-9 mb-0">
                @(maxAbsencePercentage)%
            </dd>
        </dl>
    </div>
</section>

<section class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-2 mb-4">
            <h2 class="h5 mb-0">My subjects</h2>

            <span class="badge bg-secondary">
                @enrollments.Count
            </span>
        </div>

        @if (!enrollments.Any())
        {
            <p class="text-muted mb-0">
                You are not enrolled in any subjects yet.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Subject</th>

                            <th scope="col" class="text-center">
                                Absences
                            </th>

                            <th scope="col" class="text-center">
                                Final grade
                            </th>

                            <th scope="col">Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var enrollment in enrollments)
                        {
                            var isExcluded = enrollment
                                .IsExcludedByAbsences(maxAbsencePercentage);

                            <tr>
                                <td>
                                    @enrollment.Subject.Name
                                </td>

                                <td class="text-center">
                                    @enrollment.AbsenceCount
                                </td>

                                <td class="text-center">
                                    @(enrollment.FinalGrade?.ToString("0.0") ?? "-")
                                </td>

                                <td>
                                    @if (isExcluded)
                                    {
                                        <span class="badge bg-danger">
                                            Excluded by absences
                                        </span>
                                    }
                                    else if (!enrollment.FinalGrade.HasValue)
                                    {
                                        <span class="badge bg-secondary">
                                            Not graded
                                        </span>
                                    }
                                    else if (enrollment.IsApproved(maxAbsencePercentage))
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Failed
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="text-muted small mt-3 mb-0">
                Final grades are shown on a scale of 0 to 20.
                Students whose absence percentage exceeds
                @(maxAbsencePercentage)% are excluded from the
                corresponding subject, regardless of their final grade.
            </p>
        }
    </div>
</section>