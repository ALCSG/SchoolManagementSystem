@model SchoolManagementSystem.Data.Entities.Student

@{
    ViewData["Title"] = "Archive Student";
}

<h1 class="h3 mb-3">Archive Student</h1>

<div class="alert alert-warning">
    Are you sure you want to archive this student?
    Their enrollments, grades and absences will be preserved.
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">
        @Model.FirstName @Model.LastName
    </dd>

    <dt class="col-sm-3">Class Group</dt>
    <dd class="col-sm-9">
        @(Model.ClassGroup?.Description ?? "Not assigned")
    </dd>

    <dt class="col-sm-3">Enrollments</dt>
    <dd class="col-sm-9">
        @Model.Enrollments.Count
    </dd>
</dl>

<form asp-action="Delete" method="post">
    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <input type="hidden" asp-for="StudentId" />

    <button type="submit" class="btn btn-danger">
        Archive
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>