@model SchoolManagementSystem.Models.StudentViewModel

@{
    ViewData["Title"] = "Edit Student";
}

<h1>Edit Student</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="StudentId" />

            <div class="form-group mb-3">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClassGroupId" class="control-label"></label>
                <select asp-for="ClassGroupId" asp-items="Model.ClassGroups" class="form-control">
                    <option value="">-- Select a Class Group --</option>
                </select>
                <span asp-validation-for="ClassGroupId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoPath))
                {
                    <div class="mb-2">
                        <img src="@Model.CurrentPhotoPath" alt="Current photo" style="max-width: 150px;" class="img-thumbnail" />
                    </div>
                }
                <label asp-for="PhotoFile" class="control-label">New Photo (optional)</label>
                <input asp-for="PhotoFile" type="file" class="form-control" />
                <span asp-validation-for="PhotoFile" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>