@using SchoolManagementSystem.Helpers
@model SchoolManagementSystem.Models.StudentDetailsViewModel

@{
    ViewData["Title"] = "Student Details";

    var student = Model.Student;
    var maxAbsencePercentage = Model.MaxAbsencePercentage;
    var isEmployee = User.IsInRole(AppRoles.Employee);

    var enrollments = student.Enrollments
        .OrderBy(e => e.Subject.Name)
        .ToList();
}

<h1>Student Details</h1>
<hr />

<div class="row">
    <div class="col-md-3">
        @if (!string.IsNullOrWhiteSpace(student.StudentPhotoPath))
        {
            <img src="@student.StudentPhotoPath"
                 alt="Photo of @student.FirstName @student.LastName"
                 class="img-thumbnail" />
        }
    </div>

    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">
                @student.FirstName @student.LastName
            </dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">
                @student.Email
            </dd>

            <dt class="col-sm-3">Class Group</dt>
            <dd class="col-sm-9">
                @(student.ClassGroup?.Description ?? "Not assigned")
            </dd>

            <dt class="col-sm-3">Absence limit</dt>
            <dd class="col-sm-9">
                @(maxAbsencePercentage)%
            </dd>
        </dl>
    </div>
</div>

<h4 class="mt-4">Enrollments</h4>

@if (isEmployee)
{
    <p>
        <a asp-controller="Enrollment"
           asp-action="Create"
           asp-route-studentId="@student.StudentId"
           class="btn btn-sm btn-primary">
            Add enrollment
        </a>
    </p>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Subject</th>
                <th scope="col">Absences</th>
                <th scope="col">Final Grade</th>
                <th scope="col">Status</th>

                @if (isEmployee)
                {
                    <th scope="col">Actions</th>
                }
            </tr>
        </thead>

        <tbody>
            @if (enrollments.Any())
            {
                @foreach (var enrollment in enrollments)
                {
                    <tr>
                        <td>
                            @enrollment.Subject.Name
                        </td>

                        <td>
                            @enrollment.AbsenceCount
                        </td>

                        <td>
                            @(enrollment.FinalGrade?.ToString("0.0") ?? "-")
                        </td>

                        <td>
                            @if (enrollment.IsExcludedByAbsences(maxAbsencePercentage))
                            {
                                <span class="badge bg-danger">
                                    Excluded by absences
                                </span>
                            }
                            else if (!enrollment.FinalGrade.HasValue)
                            {
                                <span class="badge bg-secondary">
                                    Not graded
                                </span>
                            }
                            else if (enrollment.IsApproved(maxAbsencePercentage))
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Failed
                                </span>
                            }
                        </td>

                        @if (isEmployee)
                        {
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Enrollment"
                                       asp-action="Edit"
                                       asp-route-id="@enrollment.EnrollmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-controller="Enrollment"
                                       asp-action="Delete"
                                       asp-route-id="@enrollment.EnrollmentId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(isEmployee ? 5 : 4)"
                        class="text-muted">
                        No enrollments yet.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="small text-muted">
    Students whose absence percentage exceeds
    @(maxAbsencePercentage)% are excluded from the corresponding
    subject, regardless of their final grade.
</p>

<div class="mt-3 d-flex flex-wrap gap-2">
    @if (isEmployee)
    {
        <a asp-controller="Student"
           asp-action="Edit"
           asp-route-id="@student.StudentId"
           class="btn btn-primary">
            Edit student
        </a>

        <a asp-controller="Student"
           asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>
    }
    else
    {
        <a asp-controller="Student"
           asp-action="MyLearning"
           class="btn btn-secondary">
            Back to My Learning
        </a>
    }
</div>