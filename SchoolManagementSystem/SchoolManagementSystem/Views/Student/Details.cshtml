@model SchoolManagementSystem.Data.Entities.Student

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>
<hr />

<div class="row">
    <div class="col-md-3">
        @if (!string.IsNullOrEmpty(Model.StudentPhotoPath))
        {
            <img src="@Model.StudentPhotoPath" alt="Student photo" class="img-thumbnail" />
        }
    </div>
    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Class Group</dt>
            <dd class="col-sm-9">@Model.ClassGroup.Description</dd>
        </dl>
    </div>
</div>

<h4 class="mt-4">Enrollments</h4>

<p>
    <a asp-controller="Enrollment" asp-action="Create" asp-route-studentId="@Model.StudentId" class="btn btn-sm btn-primary">Add enrollment</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Absences</th>
            <th>Final Grade</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Enrollments.Any())
        {
            @foreach (var enrollment in Model.Enrollments)
            {
                <tr>
                    <td>@enrollment.Subject.Name</td>
                    <td>@enrollment.AbsenceCount</td>
                    <td>@(enrollment.FinalGrade?.ToString("0.0") ?? "-")</td>
                    <td>
                        @if (enrollment.FinalGrade.HasValue)
                        {
                            <span class="badge @(enrollment.IsApproved ? "bg-success" : "bg-danger")">
                                @(enrollment.IsApproved ? "Approved" : "Failed")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Not graded</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Enrollment" asp-action="Edit" asp-route-id="@enrollment.EnrollmentId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Enrollment" asp-action="Delete" asp-route-id="@enrollment.EnrollmentId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-muted">No enrollments yet.</td></tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>