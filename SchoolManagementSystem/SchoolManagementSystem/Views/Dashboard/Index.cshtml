@model SchoolManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Administrator dashboard</h1>
<p class="text-muted">Problems reported by the staff that need your attention.</p>

<div class="d-flex align-items-center mb-3">
    <h4 class="mb-0 me-2">Open alerts</h4>
    <span class="badge @(Model.OpenAlerts.Any() ? "bg-danger" : "bg-success")">
        @Model.OpenAlerts.Count()
    </span>
</div>

@if (!Model.OpenAlerts.Any())
{
    <div class="alert alert-success">There are no open alerts. Everything is in order.</div>
}
else
{
    <div class="list-group mb-4">
        @foreach (var item in Model.OpenAlerts)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="mb-1">@item.Message</p>
                        <small class="text-muted">
                            Reported by @item.ReportedBy.FirstName @item.ReportedBy.LastName
                            on @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </small>
                    </div>

                    <form asp-controller="Alert"
                          asp-action="Resolve"
                          asp-route-alertId="@item.AlertId"
                          method="post">
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            Mark as resolved
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<h4 class="mb-1">Closed alerts</h4>
<p class="text-muted small mb-3">Showing the most recent closed alerts only.</p>

@if (!Model.ClosedAlerts.Any())
{
    <div class="alert alert-secondary">There are no closed alerts.</div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model.ClosedAlerts)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="mb-1">@item.Message</p>
                        <small class="text-muted">
                            Reported by @item.ReportedBy.FirstName @item.ReportedBy.LastName
                            on @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </small>
                    </div>

                    <form asp-controller="Alert"
                          asp-action="Unresolve"
                          asp-route-alertId="@item.AlertId"
                          method="post">
                        <button type="submit" class="btn btn-sm btn-outline-warning">
                            Undo resolution
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}