@model SchoolManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var openAlerts = Model.OpenAlerts.ToList();
    var closedAlerts = Model.ClosedAlerts.ToList();
}

<div class="mb-4">
    <h1 class="h3 mb-1">Administrator dashboard</h1>

    <p class="text-muted mb-0">
        Manage platform users and review requests reported by the staff.
    </p>
</div>

<div class="row g-4">

    <!-- User management -->
    <div class="col-12">
        <section class="card shadow-sm">
            <div class="card-body p-4">
                <div class="row align-items-center g-4">
                    <div class="col-lg-7">
                        <h2 class="h5 mb-2">User management</h2>

                        <p class="text-muted mb-0">
                            Create platform accounts, assign roles
                            and view existing users.
                        </p>
                    </div>

                    <div class="col-lg-5">
                        <div class="d-flex flex-wrap
                            justify-content-lg-end gap-2">
                            <a asp-controller="User"
                               asp-action="Create"
                               class="btn btn-primary">
                                Create user
                            </a>

                            <a asp-controller="User"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                View users
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Open alerts -->
    <div class="col-12 col-xl-6">
        <section class="card shadow-sm h-100">
            <div class="card-header bg-transparent p-4 border-bottom">
                <div class="d-flex justify-content-between
                    align-items-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">Open alerts</h2>

                        <p class="text-muted small mb-0">
                            Problems and requests awaiting resolution.
                        </p>
                    </div>

                    <span class="badge @(openAlerts.Any()
                                                                  ? "bg-danger"
                                                                  : "bg-success")">
                        @openAlerts.Count
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                @if (!openAlerts.Any())
                {
                    <div class="alert alert-success mb-0">
                        There are no open alerts. Everything is in order.
                    </div>
                }
                else
                {
                    <div class="dashboard-alert-list">
                        @foreach (var item in openAlerts)
                        {
                            <article class="border rounded p-3">
                                <div class="d-flex justify-content-between
                                    align-items-start gap-3 mb-2">
                                    <h3 class="h6 mb-0 text-break">
                                        @(string.IsNullOrWhiteSpace(item.Title)
                                            ? "Untitled alert"
                                            : item.Title)
                                    </h3>

                                    <span class="badge bg-danger">
                                        Pending
                                    </span>
                                </div>

                                <p class="text-muted small mb-1">
                                    Reported by
                                    @(item.ReportedBy != null
                                        ? $"{item.ReportedBy.FirstName} {item.ReportedBy.LastName}"
                                        : "Unknown user")
                                </p>

                                <p class="text-muted small mb-3">
                                    Created on
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </p>

                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Alert"
                                       asp-action="Details"
                                       asp-route-id="@item.AlertId"
                                       class="btn btn-sm btn-outline-primary">
                                        View details
                                    </a>

                                    <form asp-controller="Alert"
                                          asp-action="Resolve"
                                          asp-route-alertId="@item.AlertId"
                                          method="post"
                                          class="m-0">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Mark as resolved
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    </div>

    <!-- Closed alerts -->
    <div class="col-12 col-xl-6">
        <section class="card shadow-sm h-100">
            <div class="card-header bg-transparent p-4 border-bottom">
                <div class="d-flex justify-content-between
                    align-items-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">Closed alerts</h2>

                        <p class="text-muted small mb-0">
                            The most recent resolved alerts.
                        </p>
                    </div>

                    <span class="badge bg-secondary">
                        @closedAlerts.Count
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                @if (!closedAlerts.Any())
                {
                    <div class="alert alert-secondary mb-0">
                        There are no closed alerts.
                    </div>
                }
                else
                {
                    <div class="dashboard-alert-list">
                        @foreach (var item in closedAlerts)
                        {
                            <article class="border rounded p-3">
                                <div class="d-flex justify-content-between
                                    align-items-start gap-3 mb-2">
                                    <h3 class="h6 mb-0 text-break">
                                        @(string.IsNullOrWhiteSpace(item.Title)
                                            ? "Untitled alert"
                                            : item.Title)
                                    </h3>

                                    <span class="badge bg-success">
                                        Resolved
                                    </span>
                                </div>

                                <p class="text-muted small mb-1">
                                    Reported by
                                    @(item.ReportedBy != null
                                        ? $"{item.ReportedBy.FirstName} {item.ReportedBy.LastName}"
                                        : "Unknown user")
                                </p>

                                <p class="text-muted small mb-3">
                                    Created on
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </p>

                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Alert"
                                       asp-action="Details"
                                       asp-route-id="@item.AlertId"
                                       class="btn btn-sm btn-outline-primary">
                                        View details
                                    </a>

                                    <form asp-controller="Alert"
                                          asp-action="Unresolve"
                                          asp-route-alertId="@item.AlertId"
                                          method="post"
                                          class="m-0">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning">
                                            Undo resolution
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>