@model SchoolManagementSystem.Data.Entities.Subject

@{
    ViewData["Title"] = "Delete Subject";
}

<h1>Delete Subject</h1>
<h3 class="text-danger">Are you sure you want to delete this subject?</h3>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Courses</dt>
    <dd class="col-sm-9">@Model.Courses.Count</dd>

    <dt class="col-sm-3">Enrollments</dt>
    <dd class="col-sm-9">@Model.Enrollments.Count</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.SubjectId">
    <input type="hidden" asp-for="SubjectId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<hr />

<div asp-validation-summary="All" class="text-danger"></div>