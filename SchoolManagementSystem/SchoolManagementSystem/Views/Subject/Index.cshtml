@model IEnumerable<SchoolManagementSystem.Data.Entities.Subject>

@{
    ViewData["Title"] = "Subjects";
}

<h1>Subjects</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New Subject</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Courses</th>
            <th>Enrollments</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var subject in Model)
        {
            <tr>
                <td>@subject.Name</td>
                <td>@subject.Courses.Count</td>
                <td>@subject.Enrollments.Count</td>
                <td>
                    <a asp-action="Details" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>