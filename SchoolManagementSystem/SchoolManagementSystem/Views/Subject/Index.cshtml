@model IEnumerable<SchoolManagementSystem.Data.Entities.Subject>

@{
    ViewData["Title"] = "Subjects";

    var subjects = Model.Select(subject => new
    {
        SubjectId = subject.SubjectId,
        Name = subject.Name,
        TotalHours = subject.TotalHours,
        CourseCount = subject.Courses.Count,
        EnrollmentCount = subject.Enrollments.Count,
        DetailsUrl = Url.Action("Details", "Subject",
            new { id = subject.SubjectId }),
        EditUrl = Url.Action("Edit", "Subject",
            new { id = subject.SubjectId }),
        DeleteUrl = Url.Action("Delete", "Subject",
            new { id = subject.SubjectId })
    }).ToList();
}

<div class="d-flex flex-wrap justify-content-between
    align-items-center gap-3 mb-4">
    <h1 class="h3 mb-0">Subjects</h1>

    <a asp-action="Create" class="btn btn-primary">
        New Subject
    </a>
</div>

<script id="subjectActionsTemplate" type="text/x-template">
    <div class="d-flex flex-wrap gap-1">
        <a href="${DetailsUrl}"
           class="btn btn-sm btn-outline-secondary">
            Details
        </a>

        <a href="${EditUrl}"
           class="btn btn-sm btn-outline-primary">
            Edit
        </a>

        <a href="${DeleteUrl}"
           class="btn btn-sm btn-outline-danger">
            Delete
        </a>
    </div>
</script>

<ejs-grid id="SubjectsGrid"
          dataSource="@subjects"
          allowPaging="true"
          allowSorting="true"
          allowFiltering="true"
          toolbar="@(new List<string> { "Search" })"
          width="100%">

    <e-grid-pagesettings pageSize="10"
                         pageCount="5">
    </e-grid-pagesettings>

    <e-grid-filtersettings type="Menu">
    </e-grid-filtersettings>

    <e-grid-searchsettings fields="@(new string[] { "Name" })"
                           operator="contains"
                           ignoreCase="true">
    </e-grid-searchsettings>

    <e-grid-columns>
        <e-grid-column field="SubjectId"
                       isPrimaryKey="true"
                       visible="false">
        </e-grid-column>

        <e-grid-column field="Name"
                       headerText="Name"
                       width="250">
        </e-grid-column>

        <e-grid-column field="TotalHours"
                       headerText="Total Hours"
                       type="number"
                       format="N0"
                       textAlign="Center"
                       width="140">
        </e-grid-column>

        <e-grid-column field="CourseCount"
                       headerText="Courses"
                       type="number"
                       textAlign="Center"
                       width="120">
        </e-grid-column>

        <e-grid-column field="EnrollmentCount"
                       headerText="Enrollments"
                       type="number"
                       textAlign="Center"
                       width="140">
        </e-grid-column>

        <e-grid-column headerText="Actions"
                       template="#subjectActionsTemplate"
                       allowSorting="false"
                       allowFiltering="false"
                       width="260">
        </e-grid-column>
    </e-grid-columns>
</ejs-grid>