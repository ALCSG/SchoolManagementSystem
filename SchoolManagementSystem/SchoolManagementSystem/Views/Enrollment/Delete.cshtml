@model SchoolManagementSystem.Data.Entities.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<h1>Delete Enrollment</h1>
<h3 class="text-danger">Are you sure you want to delete this enrollment?</h3>

<dl class="row">
    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@Model.Student.AppUser.FirstName @Model.Student.AppUser.LastName</dd>

    <dt class="col-sm-3">Subject</dt>
    <dd class="col-sm-9">@Model.Subject.Name</dd>

    <dt class="col-sm-3">Absences</dt>
    <dd class="col-sm-9">@Model.AbsenceCount</dd>

    <dt class="col-sm-3">Final Grade</dt>
    <dd class="col-sm-9">@(Model.FinalGrade?.ToString("0.0") ?? "-")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.EnrollmentId">
    <input type="hidden" asp-for="EnrollmentId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-controller="Student" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-secondary">Cancel</a>
</form>

<hr />

<div asp-validation-summary="All" class="text-danger"></div>