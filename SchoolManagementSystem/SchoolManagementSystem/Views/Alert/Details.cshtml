@model SchoolManagementSystem.Data.Entities.Alert

@{
    ViewData["Title"] = "Alert details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h3 mb-1">Alert details</h1>
            <p class="text-muted mb-0">
                Review the reported problem or request.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                    <h2 class="h4 mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Title)
                            ? "Untitled alert"
                            : Model.Title)
                    </h2>

                    <span class="badge @(Model.IsResolved ? "bg-success" : "bg-danger")">
                        @(Model.IsResolved ? "Resolved" : "Pending")
                    </span>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-3">Reported by</dt>
                    <dd class="col-sm-9">
                        @if (Model.ReportedBy != null)
                        {
                            <span>
                                @Model.ReportedBy.FirstName @Model.ReportedBy.LastName
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Unknown user</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created at</dt>
                    <dd class="col-sm-9">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </dd>
                </dl>

                <hr class="my-4" />

                <h3 class="h6 mb-3">Message</h3>

                <div class="bg-light rounded p-3"
                     style="white-space: pre-wrap; overflow-wrap: anywhere;">
                    @Model.Message
                </div>

                @if (Model.Student != null)
                {
                    <hr class="my-4" />

                    <h3 class="h6 mb-3">Related student</h3>

                    <div class="border rounded p-3">
                        <p class="fw-semibold mb-1">
                            @Model.Student.FirstName @Model.Student.LastName
                        </p>

                        <p class="text-muted mb-3">
                            @Model.Student.Email
                        </p>

                        <a asp-controller="Student"
                           asp-action="Details"
                           asp-route-id="@Model.Student.StudentId"
                           class="btn btn-sm btn-outline-primary">
                            View student
                        </a>
                    </div>
                }

                <hr class="my-4" />

                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to dashboard
                    </a>

                    @if (Model.IsResolved)
                    {
                        <form asp-controller="Alert"
                              asp-action="Unresolve"
                              asp-route-alertId="@Model.AlertId"
                              method="post"
                              class="m-0">
                            <button type="submit" class="btn btn-outline-warning">
                                Undo resolution
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Alert"
                              asp-action="Resolve"
                              asp-route-alertId="@Model.AlertId"
                              method="post"
                              class="m-0">
                            <button type="submit" class="btn btn-success">
                                Mark as resolved
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>