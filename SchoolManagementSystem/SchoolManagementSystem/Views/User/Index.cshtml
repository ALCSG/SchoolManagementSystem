@model IEnumerable<SchoolManagementSystem.Models.UserListViewModel>

@{
    ViewData["Title"] = "Users";

    var users = Model
        .Select(user => new
        {
            Id = user.Id,
            FullName = $"{user.FirstName} {user.LastName}",
            Email = user.Email ?? string.Empty,
            RolesText = user.Roles != null && user.Roles.Any()
                ? string.Join(", ", user.Roles)
                : "No role",
            EditUrl = Url.Action(
                "Edit",
                "User",
                new { id = user.Id }),
            DeleteUrl = Url.Action(
                "Delete",
                "User",
                new { id = user.Id })
        })
        .ToList();

    var toolbarItems = new List<string> { "Search" };

    var searchFields = new string[]
    {
        "FullName",
        "Email",
        "RolesText"
    };
}

<div class="d-flex flex-wrap justify-content-between
    align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Users</h1>
        <p class="text-muted mb-0">
            Manage user accounts and their roles.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>
        Create user
    </a>
</div>

<script id="userActionsTemplate" type="text/x-template">
    <div class="d-flex flex-wrap gap-1">
        <a href="${EditUrl}"
           class="btn btn-sm btn-outline-secondary">
            Edit
        </a>

        <a href="${DeleteUrl}"
           class="btn btn-sm btn-outline-danger">
            Delete
        </a>
    </div>
</script>

<div class="card shadow-sm">
    <div class="card-body">
        <ejs-grid id="UsersGrid"
                  dataSource="@users"
                  allowPaging="true"
                  allowSorting="true"
                  allowFiltering="true"
                  toolbar="@toolbarItems"
                  width="100%">

            <e-grid-pagesettings pageSize="10"
                                 pageCount="5">
            </e-grid-pagesettings>

            <e-grid-filtersettings type="Menu">
            </e-grid-filtersettings>

            <e-grid-searchsettings fields="@searchFields"
                                   operator="contains"
                                   ignoreCase="true">
            </e-grid-searchsettings>

            <e-grid-columns>
                <e-grid-column field="Id"
                               isPrimaryKey="true"
                               visible="false">
                </e-grid-column>

                <e-grid-column field="FullName"
                               headerText="Name"
                               width="230">
                </e-grid-column>

                <e-grid-column field="Email"
                               headerText="Email"
                               width="280">
                </e-grid-column>

                <e-grid-column field="RolesText"
                               headerText="Roles"
                               width="180">
                </e-grid-column>

                <e-grid-column headerText="Actions"
                               template="#userActionsTemplate"
                               allowSorting="false"
                               allowFiltering="false"
                               width="200">
                </e-grid-column>
            </e-grid-columns>
        </ejs-grid>
    </div>
</div>