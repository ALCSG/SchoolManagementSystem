@model SchoolManagementSystem.Models.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
    var isStudentAccount = Model.StudentId.HasValue;
}

<div class="mb-4">
    <h1 class="h3 mb-1">Create user</h1>
    <p class="text-muted mb-0">
        Create a platform account or select a student awaiting an account.
    </p>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info" role="alert">
        @message
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-4">
                    @(isStudentAccount ? "Student account" : "Account details")
                </h2>

                <form asp-action="Create" method="post">
                    <input asp-for="StudentId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <span asp-validation-for="StudentId"
                          class="text-danger d-block mb-2"></span>

                    @if (isStudentAccount)
                    {
                        <div class="alert alert-info">
                            The account details come from the selected student.
                            Edit the student record first if any details are incorrect.
                        </div>

                        <input asp-for="Role" type="hidden" />

                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <div class="form-control-plaintext">
                                @Model.Role
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label"></label>

                            <select asp-for="Role"
                                    asp-items="Model.Roles"
                                    class="form-select">
                                <option value="">-- Select role --</option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger small"></span>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName"
                                   class="form-label"></label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   readonly="@isStudentAccount" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName"
                                   class="form-label"></label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   readonly="@isStudentAccount" />

                            <span asp-validation-for="LastName"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly="@isStudentAccount" />

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Create user
                        </button>
                    </div>
                </form>

                @if (isStudentAccount)
                {
                    <div class="mt-3">
                        <a asp-action="Create">
                            Clear student selection
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <h2 class="h5 mb-0">Students without an account</h2>

                    <span class="badge bg-secondary">
                        @Model.PendingStudents.Count()
                    </span>
                </div>

                <p class="text-muted small mb-4">
                    Select a student to populate the account form.
                </p>

                @if (!Model.PendingStudents.Any())
                {
                    <div class="alert alert-success mb-0">
                        There are no students awaiting an account.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 pending-students-table">
                            <thead>
                                <tr>
                                    <th scope="col">Student</th>
                                    <th scope="col" class="text-end">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var student in Model.PendingStudents)
                                {
                                    var isSelected =
                                        Model.StudentId == student.StudentId;

                                    <tr class="@(isSelected ? "student-selected" : "")">
                                        <td>
                                            <div class="fw-semibold">
                                                @student.FirstName @student.LastName
                                            </div>

                                            <div class="text-muted small text-break">
                                                @student.Email
                                            </div>
                                        </td>

                                        <td class="text-end">
                                            @if (isSelected)
                                            {
                                                <span class="badge bg-primary">
                                                    Selected
                                                </span>
                                            }
                                            else
                                            {
                                                <a asp-action="Create"
                                                   asp-route-studentId="@student.StudentId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Select
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}