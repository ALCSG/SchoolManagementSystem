<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolManagementSystem</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/_content/Syncfusion.AspNetCore.Themes/styles/fluent2.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SchoolManagementSystem.styles.css"
          asp-append-version="true" />

    <script src="~/_content/Syncfusion.AspNetCore.DropDowns/scripts/sf-multi-select.min.js"></script>
    <script src="~/_content/Syncfusion.AspNetCore.Navigations/scripts/sf-appbar.min.js"></script>
</head>
<body>
    <header>
        <ejs-appbar id="mainAppBar" colorMode="Dark">
            <e-content-template>
                <nav class="navbar navbar-expand-sm navbar-dark w-100">
                    <div class="container-fluid">
                        <a class="navbar-brand"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            School Management System
                        </a>

                        <button class="navbar-toggler"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#mainNavigation"
                                aria-controls="mainNavigation"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="navbar-collapse collapse justify-content-between"
                             id="mainNavigation">
                            <ul class="navbar-nav flex-grow-1">
                                @if (User.IsInRole(AppRoles.Admin) ||
                                     User.IsInRole(AppRoles.Employee))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="Course"
                                           asp-action="Index">
                                            Courses
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="Subject"
                                           asp-action="Index">
                                            Subjects
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole(AppRoles.Employee))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="ClassGroup"
                                           asp-action="Index">
                                            Class Groups
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="Student"
                                           asp-action="Index">
                                            Students
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="Alert"
                                           asp-action="Create">
                                            Report a problem
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole(AppRoles.Admin))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            Dashboard
                                        </a>
                                    </li>
                                }
                            </ul>

                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>

                <div class="container appbar-heading">
                    <h2>School Management System</h2>
                    <p>Connecting students, courses and your school community.</p>
                </div>
            </e-content-template>
        </ejs-appbar>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <main role="main" class="pb-3">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SchoolManagementSystem -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <ejs-scripts></ejs-scripts>
</body>
</html>