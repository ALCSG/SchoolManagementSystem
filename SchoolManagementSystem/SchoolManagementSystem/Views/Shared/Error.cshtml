@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="error-page text-center py-5">
    <h1 class="display-1 fw-bold text-danger">@Model.StatusCode</h1>
    <h2 class="mb-3">@Model.Title</h2>
    <p class="lead text-muted">@Model.Message</p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        Back to home page
    </a>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mt-4">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }
</div>